rules_version = '2';

// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
//
// Trust model
//   * Admin  = the Google-signed-in user whose uid is households/{hid}.adminUid.
//   * Member = any device (anonymous uid) with households/{hid}/members/{uid}.status == 'approved'.
//   * Anyone else can do exactly one thing: read ONE invite doc by its unguessable token and
//     create their OWN members/{uid} doc with status 'pending'. They can never approve themselves.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }
    function memberPath(hid, uid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(uid);
    }
    function isAdmin(hid) {
      return signedIn() && get(householdPath(hid)).data.adminUid == request.auth.uid;
    }
    function isApproved(hid) {
      return signedIn()
        && exists(memberPath(hid, request.auth.uid))
        && get(memberPath(hid, request.auth.uid)).data.status == 'approved';
    }
    // The regex check runs first (&& short-circuits) so a token can never smuggle in a '/'.
    function validInvite(token, hid) {
      return token is string
        && token.matches('^[A-Za-z0-9_-]{32,64}$')
        && exists(/databases/$(database)/documents/invites/$(token))
        && get(/databases/$(database)/documents/invites/$(token)).data.householdId == hid
        && get(/databases/$(database)/documents/invites/$(token)).data.active == true
        && get(/databases/$(database)/documents/invites/$(token)).data.expiresAt > request.time;
    }

    // ---------- users/{uid}: private pointer "which household am I in?" ----------
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['householdId', 'householdName', 'displayName', 'email', 'isAnonymous', 'createdAt']);
      allow list, delete: if false;
    }

    // ---------- invites/{token}: readable one-by-one, never listable ----------
    match /invites/{token} {
      allow get: if signedIn();
      allow create: if signedIn()
        && token.matches('^[A-Za-z0-9_-]{32,64}$')
        && isAdmin(request.resource.data.householdId)
        && request.resource.data.keys().hasOnly(
             ['householdId', 'householdName', 'createdBy', 'active', 'createdAt', 'expiresAt'])
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
      // The only edit ever allowed: switching an invite off.
      allow update: if isAdmin(resource.data.householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow list, delete: if false;
    }

    // ---------- households/{hid} ----------
    match /households/{hid} {
      allow read: if isApproved(hid);

      // Only a Google-signed-in user can create a household, and only as its admin.
      allow create: if isGoogle()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'adminUid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin(hid)
        && request.resource.data.adminUid == resource.data.adminUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'activeInviteToken']);

      allow delete: if false;

      // ---- the Waiting Room: members/{uid} ----
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin(hid));
        allow list: if isAdmin(hid);

        // (a) A device asks to join: pending only, must present a live invite token.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(
               ['role', 'status', 'deviceName', 'inviteToken', 'requestedAt'])
          && request.resource.data.role == 'member'
          && request.resource.data.status == 'pending'
          && request.resource.data.deviceName is string
          && request.resource.data.deviceName.size() <= 40
          && request.resource.data.requestedAt == request.time
          && validInvite(request.resource.data.inviteToken, hid);

        // (b) The admin's own member doc, written in the same batch as the household doc.
        allow create: if isGoogle() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(
               ['role', 'status', 'deviceName', 'requestedAt', 'approvedAt'])
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'approved'
          && getAfter(householdPath(hid)).data.adminUid == request.auth.uid;

        // Approve / deny / re-approve: admin only, status fields only, never the admin's own doc.
        allow update: if isAdmin(hid)
          && uid != get(householdPath(hid)).data.adminUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'removedAt'])
          && request.resource.data.status in ['pending', 'approved', 'removed'];

        // "Forget" a stale device so it may ask again.
        allow delete: if isAdmin(hid) && uid != get(householdPath(hid)).data.adminUid;
      }

      // ---- shared pantry data: approved members only ----
      match /items/{itemId} {
        allow read, delete: if isApproved(hid);
        allow create, update: if isApproved(hid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80;
      }

      // Append-only audit trail (restocked / emptied / undo).
      match /logs/{logId} {
        allow read: if isApproved(hid);
        allow create: if isApproved(hid) && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
